{
    "version": 2,
    "builds": [
      {
        "src": "src/**/*",
        "use": "@vercel/react"
      },
      {
        "src": "api/**/*.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/productos",
        "dest": "/api/productos.js"
      },
      {
        "src": "/productos/(.*)",
        "dest": "/api/productos.js"
      }
    ]
  }
  